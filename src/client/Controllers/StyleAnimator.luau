--!strict
--[[
    StyleAnimator.luau
    Plays the Blender-authored style animations (Shared.Modules.StyleAnimations, generated by
    tools/blender/style_anims.py) on any character, including the Styles-menu preview avatar.
    It overrides joint Transforms right after the Animator each frame (PreSimulation), blending over the
    current animation, so nothing has to be uploaded: every client plays the casts it hears about.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local StyleAnimations = require(ReplicatedStorage.Shared.Modules.StyleAnimations)

local StyleAnimator = {}

local FADE_IN = 0.08
local FADE_OUT = 0.15

type Clip = {
    length: number,
    looped: boolean,
    joints: { string },
    times: { number },
    styles: { Enum.EasingStyle },
    directions: { Enum.EasingDirection },
    frames: { { CFrame } },
}
type Playback = { clip: Clip, joints: { [number]: Instance }, started: number, fadeOutAt: number? }

local clips: { [string]: Clip } = {}
local playing: { [Model]: Playback } = {}
-- What we last wrote to each joint. If it still holds that value, no Animator touched it this frame,
-- so we blend from rest instead of from our own previous output.
local written: { [Instance]: CFrame } = setmetatable({}, { __mode = "k" }) :: any

local function getClip(name: string): Clip?
    local cached = clips[name]
    if cached then return cached end
    local anim = StyleAnimations[name]
    if not anim then return nil end

    local clip: Clip = { length = anim.length, looped = anim.looped, joints = anim.joints, times = {}, styles = {}, directions = {}, frames = {} }
    for k, key in anim.keys do
        local style, direction = string.match(key.ease, "^(%a+)%s*(%a*)$")
        clip.times[k] = key.t
        clip.styles[k] = (Enum.EasingStyle :: any)[style or "Linear"]
        clip.directions[k] = (Enum.EasingDirection :: any)[if direction and direction ~= "" then direction else "InOut"]
        local frame = {}
        for j = 1, #anim.joints do
            local p = key.pose
            local o = (j - 1) * 6
            frame[j] = CFrame.new(p[o + 4], p[o + 5], p[o + 6]) * CFrame.Angles(math.rad(p[o + 1]), math.rad(p[o + 2]), math.rad(p[o + 3]))
        end
        clip.frames[k] = frame
    end
    clips[name] = clip
    return clip
end

local function findJoints(character: Model, names: { string }): { [number]: Instance }
    local byName: { [string]: Instance } = {}
    for _, item in character:GetDescendants() do
        if item:IsA("AnimationConstraint") or item:IsA("Motor6D") then
            byName[item.Name] = item
        end
    end
    local joints: { [number]: Instance } = {}
    for i, name in names do
        joints[i] = byName[name]
    end
    return joints
end

local function step()
    local now = os.clock()
    for character, playback in playing do
        local clip = playback.clip
        local elapsed = now - playback.started
        local weight = math.min(1, elapsed / FADE_IN)
        if not clip.looped then
            if elapsed >= clip.length then
                playing[character] = nil
                continue
            end
            weight = math.min(weight, (clip.length - elapsed) / FADE_OUT)
        end
        if playback.fadeOutAt then
            local fade = 1 - (now - playback.fadeOutAt) / FADE_OUT
            if fade <= 0 then
                playing[character] = nil
                continue
            end
            weight = math.min(weight, fade)
        end
        if not character.Parent then
            playing[character] = nil
            continue
        end

        -- Segment [k - 1, k] containing t, eased with the target key's easing
        local times = clip.times
        local t = if clip.looped then elapsed % clip.length else elapsed
        local k = #times
        for i = 2, #times do
            if t <= times[i] then
                k = i
                break
            end
        end
        local from, to = clip.frames[math.max(k - 1, 1)], clip.frames[k]
        local span = times[k] - times[math.max(k - 1, 1)]
        local alpha = if span > 0 then math.clamp((t - times[k - 1]) / span, 0, 1) else 1
        alpha = TweenService:GetValue(alpha, clip.styles[k], clip.directions[k])

        for j = 1, #clip.joints do
            local joint = playback.joints[j]
            if joint then
                local target: any = joint -- AnimationConstraint or Motor6D; both have Transform
                local current: CFrame = target.Transform
                local base = if written[joint] == current then CFrame.identity else current
                local pose = from[j]:Lerp(to[j], alpha)
                local value = if weight >= 1 then pose else base:Lerp(pose, weight)
                target.Transform = value
                written[joint] = value
            end
        end
    end
end

-- Plays `name` (e.g. "Tsinelas_Q", "Bathala_Pose") on the character, replacing what it was playing.
-- Looped animations run until Stop. Returns false if there is no such animation.
function StyleAnimator.Play(character: Model, name: string): boolean
    local clip = getClip(name)
    if not clip then return false end
    playing[character] = { clip = clip, joints = findJoints(character, clip.joints), started = os.clock(), fadeOutAt = nil }
    return true
end

function StyleAnimator.Stop(character: Model)
    local playback = playing[character]
    if playback and not playback.fadeOutAt then
        playback.fadeOutAt = os.clock()
    end
end

RunService.PreSimulation:Connect(step)

return StyleAnimator
